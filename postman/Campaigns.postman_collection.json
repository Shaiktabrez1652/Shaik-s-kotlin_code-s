{
  "info": {
    "name": "Campaigns API",
    "_postman_id": "b5f9f6d3-4c4a-4c1b-9f5a-0a1d2e3f4b5c",
    "description": "Postman collection for the Campaigns API (local server)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Campaign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Diwali Mega Sale\",\n  \"clientName\": \"Walmart\",\n  \"startDate\": \"2025-10-20\",\n  \"endDate\": \"2025-11-10\",\n  \"description\": \"Big sale\",\n  \"budget\": 50000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/campaigns",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns"
          ]
        }
      }
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Response has id', function () { pm.expect(json).to.have.property('id'); });",
              "pm.environment.set('lastCampaignId', json.id);",
              "try { var req = pm.request.body && pm.request.body.raw ? JSON.parse(pm.request.body.raw) : null; if (req) { pm.test('Response name matches request', function () { pm.expect(json.name).to.eql(req.name); }); pm.test('Response budget matches request', function () { pm.expect(json.budget).to.eql(req.budget); }); } } catch(e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Campaigns",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/campaigns",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns"
          ]
        }
      }
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an array', function () { var json = pm.response.json(); pm.expect(Array.isArray(json)).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Campaign by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/campaigns/{{lastCampaignId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns",
            "{{lastCampaignId}}"
          ]
        }
      },
      "description": "Uses `{{lastCampaignId}}` set by the Create Campaign test script"
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response id matches environment id', function () { var json = pm.response.json(); pm.expect(json.id).to.eql(pm.environment.get('lastCampaignId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Campaign by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/campaigns/{{lastCampaignId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "campaigns",
            "{{lastCampaignId}}"
          ]
        }
      },
      "description": "Uses `{{lastCampaignId}}` set by the Create Campaign test script"
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 204', function () { pm.expect([200,204]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ]
}
